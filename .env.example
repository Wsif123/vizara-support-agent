# Groq API keys for the support agent — comma-separated for round-robin rotation.
# Get keys at https://console.groq.com/keys
GROQ_API_KEYS=key1,key2

# Legacy single-key variable, used only if GROQ_API_KEYS is empty.
SUPPORT_AGENT_GROQ_API_KEY=

# Cerebras fallback (used when every Groq key fails).
# Get a key at https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Model IDs. Optional — defaults are shown. Override here (or in Render) if a
# provider deprecates a model, without touching code.
GROQ_MODEL=openai/gpt-oss-20b
CEREBRAS_MODEL=gpt-oss-120b

# Formspree endpoint used to email escalations, e.g.
# https://formspree.io/f/<your-form-id>
# Leaving this empty disables escalation email (events are still logged).
NOTIFY_FORMSPREE_URL=

# Where escalation emails are delivered (included in the email body/subject).
NOTIFY_EMAIL_TO=you@example.com

# Legacy / unused — the notifier sends via Formspree, not SMTP.
# NOTIFY_SMTP_USER=
# NOTIFY_SMTP_APP_PASSWORD=
