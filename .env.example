# Groq API keys for the support agent — comma-separated for round-robin rotation.
# Get keys at https://console.groq.com/keys
GROQ_API_KEYS=key1,key2

# Legacy single-key variable, used only if GROQ_API_KEYS is empty.
SUPPORT_AGENT_GROQ_API_KEY=

# Cerebras fallback (used when every Groq key fails).
# Get a key at https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Where escalation emails are delivered (sent through Formspree).
NOTIFY_EMAIL_TO=you@example.com

# Legacy / unused — the notifier currently sends via Formspree, not SMTP.
# NOTIFY_SMTP_USER=
# NOTIFY_SMTP_APP_PASSWORD=
