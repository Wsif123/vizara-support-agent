# Groq API keys for the support agent — comma-separated for round-robin rotation.
# Get keys at https://console.groq.com/keys
# The operator console imports these once into encrypted local storage, then
# manages the pool from its API keys page. On Render (where the console DB is
# absent) these environment keys remain the fallback.
GROQ_API_KEYS=key1,key2

# Legacy single-key variable, used only if GROQ_API_KEYS is empty.
SUPPORT_AGENT_GROQ_API_KEY=

# Model ID. Optional — the default is shown. Can also be changed in the
# console without editing code.
GROQ_MODEL=openai/gpt-oss-20b

# Force env-only key resolution (skip the local encrypted store). Useful on
# Render or in CI. Leave empty locally.
KEY_SOURCE=

# Trust X-Forwarded-For / X-Real-IP from a hosting proxy for per-visitor rate
# limits. Set to 1 on Render (it is also enabled automatically when the RENDER
# env var is present). Leave empty locally so spoofed headers are ignored.
TRUST_PROXY=

# ---------------------------------------------------------------------------
# Operator console (local only, start with start-dashboard.bat)
# ---------------------------------------------------------------------------
# Public URL of the deployed bot, used for widget snippets and health checks.
PUBLIC_BOT_URL=
RENDER_DEMO_URL=

# Optional: read live conversations from Neon/Postgres instead of local SQLite.
# Install first: pip install "psycopg[binary]"
DATABASE_URL=

# Optional public store URLs shown on the Billing page.
LEMON_SQUEEZY_STORE_URL=
SAFEPAY_STORE_URL=

# Set to 1 only if you serve the console over HTTPS (not used locally).
VIZARA_COOKIE_SECURE=0

# ---------------------------------------------------------------------------
# Escalation notifications
# ---------------------------------------------------------------------------
# Provider for escalation email: "formspree" (default) or "resend".
NOTIFY_PROVIDER=formspree

# Formspree endpoint used when NOTIFY_PROVIDER=formspree, e.g.
# https://formspree.io/f/<your-form-id>
NOTIFY_FORMSPREE_URL=

# Resend API key used when NOTIFY_PROVIDER=resend.
RESEND_API_KEY=

# Resend sender address. Defaults to onboarding@resend.dev when empty.
NOTIFY_FROM=

# Operator escalation address. By default this is the only recipient. Set
# escalation.direct_to_client: true in a client's YAML to send to that client's
# escalation.email first and this operator address as CC. If the selected
# provider's setting above is empty, escalations are marked undelivered.
NOTIFY_EMAIL_TO=you@example.com

# Legacy / unused — the notifier sends via Formspree or Resend, not SMTP.
# NOTIFY_SMTP_USER=
# NOTIFY_SMTP_APP_PASSWORD=
